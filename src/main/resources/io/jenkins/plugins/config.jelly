<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:stapler" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
    
    <f:entry title="${%Configure}" field="name">
        <f:textbox />
    </f:entry>

    <f:entry title="${%Token}" field="token">
        <f:password />
     </f:entry>

    <f:entry name="abendAPI" title="Abend-AID API" field="abendAPI">
        <f:select id="apiDropdown" onChange="abendAPI(this.value)"/>
    </f:entry>

    <div id="reportNum" style="display: none;">
        <f:entry title="${%Report}" field="reportNum">
            <f:textbox/>
        </f:entry>
    </div>

    <script type="text/javascript">
        function abendAPI(selectedValue) {
            var element = document.getElementById('reportNum');
            (selectedValue === 'report') ? element.style.display = 'block' : element.style.display = 'none';
        }

        document.addEventListener("DOMContentLoaded", function() {
            var dropdown = document.getElementById('apiDropdown');
            if (dropdown) {
                abendAPI(dropdown.value);
            }
        });
    </script>
</j:jelly>
